# Human API — Environment Variables Template
# Copy this file to .env.local and populate with your configuration

# ==========================================
# Database (PostgreSQL / Supabase)
# ==========================================
# Connection string to PostgreSQL database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# Supabase Realtime & API Client
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ==========================================
# Monad Testnet Blockchain Configuration
# ==========================================
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL="https://testnet-rpc.monad.xyz/"
NEXT_PUBLIC_CONTRACT_ADDRESS="0x3aB8749cD941F48C8b5773172E9D840888BEb1Fe"

# ==========================================
# WalletConnect Configuration
# ==========================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"

# ==========================================
# OpenCode Zen AI Configuration
# ==========================================
OPENCODE_ZEN_API_KEY="your-opencode-zen-api-key"
OPENCODE_ZEN_MODEL="meta-llama/llama-3.1-8b-instruct"
